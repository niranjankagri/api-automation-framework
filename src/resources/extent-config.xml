<?xml version="1.0" encoding="UTF-8"?>
<!-- Look and feel of the Extent (Spark) report, loaded by BaseTest.startReport() -->
<extentreports>
	<configuration>
		<!-- report theme -->
		<!-- standard, dark -->
		<theme>standard</theme>

		<!-- document encoding -->
		<!-- defaults to UTF-8 -->
		<encoding>UTF-8</encoding>

		<!-- protocol for script and stylesheets -->
		<!-- defaults to https -->
		<protocol>https</protocol>

		<!-- show the timeline on the dashboard -->
		<timelineEnabled>true</timelineEnabled>

		<!-- title of the document (browser tab) -->
		<documentTitle>API Automation Report</documentTitle>

		<!-- report name - displayed at top-nav -->
		<reportName>Automation Report</reportName>

		<!-- date and time format of the test timestamps -->
		<timeStampFormat>yyyy-MM-dd HH:mm:ss</timeStampFormat>

		<!-- custom javascript -->
		<js>
      <![CDATA[
      ]]>
		</js>

		<!-- custom styles -->
		<css>
      <![CDATA[
      ]]>
		</css>
	</configuration>
</extentreports>
